{
  "name": "@flownote/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file .env --import tsx/esm --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "benchmark": "tsx src/__benchmarks__/api.benchmark.ts",
    "benchmark:1000qps": "BENCH_MODE=${BENCH_MODE:-sustained} BENCH_TARGET_QPS=${BENCH_TARGET_QPS:-1200} BENCH_MIN_RPS=${BENCH_MIN_RPS:-1000} BENCH_USERS=${BENCH_USERS:-32} BENCH_SEED_ITEMS=${BENCH_SEED_ITEMS:-20} BENCH_DURATION_SECONDS=${BENCH_DURATION_SECONDS:-60} BENCH_WARMUP_ITERATIONS=${BENCH_WARMUP_ITERATIONS:-10} tsx src/__benchmarks__/api.benchmark.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@flownote/shared": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "@scalar/hono-api-reference": "^0.5.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "pg": "^8.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^2.1.9",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
