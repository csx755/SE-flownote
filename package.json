{
  "name": "flownote",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @flownote/api dev\" \"pnpm --filter @flownote/web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "db:push": "pnpm --filter @flownote/api db:push",
    "db:studio": "pnpm --filter @flownote/api db:studio"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
